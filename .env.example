# ── Database ────────────────────────────────────────────
DATABASE_URL="postgresql://hookups:hookups_dev@localhost:5432/hookups"

# ── Redis ────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-64-char-random-string"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="30d"

# ── PIN ──────────────────────────────────────────────────
BCRYPT_ROUNDS=12
# Per-user PIN salt prefix — rotate yearly, keep old value to verify old hashes
PIN_SALT_PREFIX="hku_2026_"

# ── Server ───────────────────────────────────────────────
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV=development

# ── Twilio ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# ── Onfido ───────────────────────────────────────────────
ONFIDO_API_TOKEN=
ONFIDO_WEBHOOK_SECRET=

# ── AWS KMS (leave blank for dev — uses local mock) ──────
AWS_REGION=af-south-1
AWS_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Crypto ───────────────────────────────────────────────
# ed25519 signing key for consent records (base64-encoded 64-byte private key)
CONSENT_SIGNING_KEY=
