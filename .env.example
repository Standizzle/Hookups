# ── Database ────────────────────────────────────────────
DATABASE_URL="postgresql://hookups:hookups_dev@localhost:5432/hookups"

# ── Redis ────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-64-char-random-string"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="30d"

# ── PIN ──────────────────────────────────────────────────
BCRYPT_ROUNDS=12
# Per-user PIN salt prefix — rotate yearly, keep old value to verify old hashes
PIN_SALT_PREFIX="hku_2026_"

# ── Server ───────────────────────────────────────────────
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV=development

# ── Twilio ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# ── Onfido ───────────────────────────────────────────────
ONFIDO_API_TOKEN=
ONFIDO_WEBHOOK_SECRET=

# ── AWS KMS (consent record signing) ─────────────────────
# Leave AWS_KMS_KEY_ID blank for dev/CI — CryptoService falls back to an
# ephemeral in-process ed25519 keypair (signatures won't survive a restart,
# which is fine locally). In production, create an asymmetric KMS key with
# KeySpec ECC_NIST_EDWARDS25519 and KeyUsage SIGN_VERIFY, grant this service
# kms:Sign + kms:Verify on it, and set AWS_KMS_KEY_ID to its ARN/key ID.
AWS_REGION=af-south-1
AWS_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Storage (avatar/gallery photos) ───────────────────────
# Leave blank for local disk (server/uploads/). Set to "s3" to use S3/R2.
AVATAR_STORAGE=

# ── Stripe (subscription billing) ─────────────────────────
# Leave STRIPE_SECRET_KEY blank for dev/CI — BillingService falls back to
# instant local activation with no payment collection. In production, set
# these to real values from the Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIVIDUAL=
STRIPE_PRICE_FAMILY_BASE=
STRIPE_PRICE_EXTRA_GUARDIAN=
STRIPE_PRICE_EXTRA_CHILD=
STRIPE_PRICE_FAMILY_UNLIMITED=
